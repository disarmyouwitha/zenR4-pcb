  (text "Draft Corne — right new Choc layout / DRAFT C" (at 25.4 25.4 0)
    (effects (font (size 2.2 2.2)) (justify left))
    (uuid 6a2df474-931f-5f0f-94be-2724ea2dd7aa)
  )
  (text "21 Choc switches; column drives switch then diode anode; diode stripe toward row."
    (at 25.4 40.64 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 482b2e2a-7e05-52be-a8f8-aae49add92bf)
  )
  (text "C0 is outside; C5 is at the seam on both halves." (at 25.4 185.42 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 685c49d5-e9fe-5855-ba6c-5704c02747ba)
  )
  (text "Same matrix pins as left. D2/D3/D4 are free for optional display."
    (at 25.4 195.58 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 683f3fe6-fa7c-51e1-bac9-5c5d40727294)
  )
  (text "Right nice!view: CS D4 active high; MOSI D2; SCK D3. J2 included."
    (at 25.4 205.74 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid cff00348-0281-5d33-b9a1-473bdc04a76b)
  )
  (text "Front-mounted nice!nano, components down. Battery wire pads, no JST."
    (at 25.4 215.9 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 4d0780f8-af8f-5b7d-8e51-30003c049038)
  )
  (text "1.6 mm nominal draft; own plate/base. Not a Zen case replacement."
    (at 25.4 246.38 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 5a60df93-0f5f-56d7-8c60-735010ccfa08)
  )

