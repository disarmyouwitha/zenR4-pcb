  (text "Zen R4 — left carrier layout / DRAFT A" (at 25.4 25.4 0)
    (effects (font (size 2.2 2.2)) (justify left))
    (uuid 182b6672-5da5-521d-b729-a5e3849ff0f2)
  )
  (text "21 Choc switches; column drives switch then diode anode; diode stripe toward row."
    (at 25.4 40.64 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 5ad29ab8-e859-5ab0-b869-b9e197e7aa79)
  )
  (text "C0 is outside; C5 is at the seam on both halves." (at 25.4 185.42 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 4975f250-e6b1-564c-bd37-38bdd38f2a53)
  )
  (text "Tested left matrix and QSPI assignments kept. IO2 and IO3 are data; do not strap them."
    (at 25.4 195.58 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid b0d801d1-832f-5213-a46b-fbee14bb23e5)
  )
  (text "No left display." (at 25.4 205.74 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 8eb6042b-ace7-5f18-b417-2d524a434669)
  )
  (text "Backside edge-contact nano; modified plastic base. Zen thumb centers and boss reliefs."
    (at 25.4 215.9 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 2446937d-4abd-5830-bd20-cbdb182865f2)
  )
  (text "V2 PCB measured 1.65 mm; replacement thickness pending. Physical dry fit reported."
    (at 25.4 246.38 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid aca3de3a-9f86-5121-9315-9e0c1fb72e29)
  )
  (text "3V3_SW is the module edge VCC; P0.13 controls it inside the module."
    (at 25.4 226.06 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 5ceee6cc-b660-5498-9bc9-28393f482cf3)
  )
  (text "Draft flash decoupling and CS pull-up require placement and power-on review."
    (at 25.4 236.22 0)
    (effects (font (size 1.25 1.25)) (justify left))
    (uuid 2b282b97-7c40-599c-9ded-1b9445260c2b)
  )

